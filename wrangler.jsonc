{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soundboard",
  "main": "worker.js",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
